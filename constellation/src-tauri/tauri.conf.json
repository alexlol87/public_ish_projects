{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Constellation",
  "version": "0.2.0",
  "identifier": "dev.constellation.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Constellation", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 500 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "A vault of linked markdown notes about projects, repos and endpoints",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" }
  }
}
